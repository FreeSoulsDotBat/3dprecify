# Normalize line endings: LF in the repo by default.
* text=auto eol=lf

# Windows-native scripts keep CRLF in the working tree.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# POSIX shell scripts must stay LF.
*.sh text eol=lf

# Binary assets (never normalize/diff).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.zip binary
*.lockb binary
