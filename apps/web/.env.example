# apps/web environment (Vite). Copy to .env.development for local dev with the
# Firebase Auth emulator, or .env.production for a real deploy. All VITE_* vars are
# public (shipped to the browser) — never put secrets here.

# --- Local dev with the Firebase Auth emulator (no cloud, no real project) ---
VITE_USE_AUTH_EMULATOR=true
VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_PROJECT_ID=demo-precifica3d
VITE_FIREBASE_AUTH_DOMAIN=demo-precifica3d.firebaseapp.com
VITE_FIREBASE_APP_ID=demo-app

# Backend base URL (optional for the calculator — the calc runs client-side).
VITE_API_BASE_URL=http://localhost:8000

# --- Real deploy (UAT/prod) would instead use the actual Firebase web config and
# --- VITE_USE_AUTH_EMULATOR=false (see specs/002-foundation/dod-evidence.md).
