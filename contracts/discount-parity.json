        {
            "id": "amount-subcent-rounds-up",
            "description": "AMOUNT R$ 10,005 digitado -> quantiza para 10,01 ANTES de entrar na conta (ADR-0008).",
            "gross": "150.00",
            "discount": {
                "mode": "AMOUNT",
                "engineValue": 10.005,
                "wireValue": "10.01",
                "wireAmount": "10.01"
            },
            "expected": "accept",
            "expectedDiscountAmount": "10.01",
            "expectedNet": "139.99"
        }
    ]
}
