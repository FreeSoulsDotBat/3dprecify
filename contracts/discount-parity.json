        {
            "id": "pct-rounding-half-cent-down",
            "description": "PCT 2,5% sobre 20,10 = 0,5025 -> arredonda para 0,50 (ADR-0008 HALF_UP na 3a casa < 5).",
            "gross": "20.10",
