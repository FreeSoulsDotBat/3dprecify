            "title": "Marketplace"
          },
          "determinantsSchema": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Determinantsschema"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/FeeEntry"
            },
            "type": "array",
