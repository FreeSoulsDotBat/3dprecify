{
  "openapi": "3.1.0",
  "info": {
    "title": "Precifica3D API",
    "version": "0.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
