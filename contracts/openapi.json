  "components": {
    "schemas": {
      "CurrentUser": {
        "properties": {
          "uid": {
            "type": "string",
            "title": "Uid"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "uid"
        ],
        "title": "CurrentUser"
      },
      "EntitlementView": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "none",
              "active",
              "lapsed"
            ],
            "title": "Status"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "expiresAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expiresat"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "EntitlementView"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "correlationId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlationid"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_ERROR",
          "UNAUTHENTICATED",
          "TOKEN_EXPIRED",
          "FORBIDDEN",
          "NOT_FOUND",
          "INTERNAL",
          "ENTITLEMENT_REQUIRED"
        ],
        "title": "ErrorCode",
        "description": "Single source of wire error codes. Mirrored to TS via Orval (A5)."
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope"
      },
      "FeeCatalog": {
        "properties": {
          "catalogVersion": {
            "type": "string",
            "title": "Catalogversion"
          },
          "schemaVersion": {
            "type": "string",
            "title": "Schemaversion"
          },
          "generatedAt": {
            "type": "string",
            "title": "Generatedat"
          },
          "marketplaces": {
            "items": {
              "$ref": "#/components/schemas/MarketplaceCatalog"
            },
            "type": "array",
            "title": "Marketplaces"
          }
        },
        "type": "object",
        "required": [
          "catalogVersion",
          "schemaVersion",
          "generatedAt",
          "marketplaces"
        ],
        "title": "FeeCatalog"
      },
      "FeeEntry": {
        "properties": {
          "determinants": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Determinants"
          },
          "commissionPct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Commissionpct"
          },
          "fixedFee": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fixedfee"
          },
          "minPerItem": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Minperitem"
          },
          "priceBands": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/PriceBand"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pricebands"
          },
          "freight": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/FreightNone"
              },
              {
                "$ref": "#/components/schemas/FreightEstimate"
              },
              {
                "$ref": "#/components/schemas/FreightBandVoucher"
              }
            ],
            "title": "Freight",
            "discriminator": {
              "propertyName": "kind",
              "mapping": {
                "BAND_VOUCHER": "#/components/schemas/FreightBandVoucher",
                "ESTIMATE": "#/components/schemas/FreightEstimate",
                "NONE": "#/components/schemas/FreightNone"
              }
            }
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "sourceUrl": {
            "type": "string",
            "title": "Sourceurl"
          },
          "effectiveDate": {
            "type": "string",
            "title": "Effectivedate"
          },
          "lastReviewed": {
            "type": "string",
            "title": "Lastreviewed"
          }
        },
        "type": "object",
        "required": [
          "determinants",
          "commissionPct",
          "fixedFee",
          "freight",
          "source",
          "sourceUrl",
          "effectiveDate",
          "lastReviewed"
        ],
        "title": "FeeEntry"
      },
      "FilamentIn": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "material": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Material"
          },
          "costPerRoll": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Costperroll"
          },
          "rollWeightKg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Rollweightkg"
          },
          "defaultWasteGrams": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Defaultwastegrams",
            "default": "0"
          }
        },
        "type": "object",
        "required": [
          "name",
          "costPerRoll",
          "rollWeightKg"
        ],
        "title": "FilamentIn"
      },
      "FilamentOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "material": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Material"
          },
          "costPerRoll": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Costperroll"
          },
          "rollWeightKg": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Rollweightkg"
          },
          "defaultWasteGrams": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Defaultwastegrams"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Updatedat"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "costPerRoll",
          "rollWeightKg",
          "defaultWasteGrams",
          "createdAt",
          "updatedAt"
        ],
        "title": "FilamentOut"
      },
      "FreightBandVoucher": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "BAND_VOUCHER",
            "title": "Kind"
          },
          "bands": {
            "items": {
              "$ref": "#/components/schemas/VoucherBand"
            },
            "type": "array",
            "title": "Bands"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "bands"
        ],
        "title": "FreightBandVoucher"
      },
      "FreightEstimate": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "ESTIMATE",
            "title": "Kind"
          },
          "thresholdPrice": {
            "type": "number",
            "title": "Thresholdprice"
          },
          "defaultSubsidy": {
            "type": "number",
            "title": "Defaultsubsidy"
          },
          "inputs": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Inputs"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "thresholdPrice",
          "defaultSubsidy"
        ],
        "title": "FreightEstimate"
      },
      "FreightNone": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "NONE",
            "title": "Kind"
          }
        },
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "FreightNone"
      },
      "MarketplaceCatalog": {
        "properties": {
          "marketplace": {
            "type": "string",
            "enum": [
              "MERCADO_LIVRE",
              "AMAZON",
              "SHOPEE"
