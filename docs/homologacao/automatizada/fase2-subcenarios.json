  "bateria_de_testes": {
    "explicacao": "Cada subcenário recebe a MESMA bateria de 8 categorias, instanciada com os dados daquele subcenário. São 20+ execuções reais por subcenário, não 20 nomes.",
    "categorias": {
      "C1_input_invalido": "negativos, zero, 1e308, decimal com ponto vs vírgula, texto em campo numérico, emoji, string de 10k, campo vazio, só espaços, colagem de valor formatado, notação científica, sinal duplicado",
      "C2_usuario_burro": "clique frenético no botão de salvar, pular etapas, preencher fora de ordem, voltar do navegador no meio, refresh no meio, duas abas, submeter sem preencher, fechar folha no meio da gravação",
      "C3_estresse_de_dados": "listas grandes, nomes duplicados, nomes no limite, valores no teto NUMERIC do backend, quantidade no teto int4",
      "C4_rede": "throttling 3G, offline no meio da operação, 500 do servidor, 422, timeout, resposta malformada",
      "C5_sessao": "sessão expirada no meio, logout em outra aba, token inválido, entitlement que muda durante o uso",
      "C6_acolhimento": "mensagem compreensível por leigo, ausência de jargão técnico, ausência de stack/JSON cru, feedback de loading, estado vazio que ensina, unidade visível ao lado do número",
      "C7_acessibilidade": "axe-core (sem violações críticas), navegação por teclado, foco visível, rótulo associado, alvo de toque >= 44px",
      "C8_concorrencia": "duas abas editando o mesmo registro, duas operações simultâneas, salvar duas vezes em paralelo"
    }
  }
